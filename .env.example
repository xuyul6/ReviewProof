# Copy to .env and fill in. .env is git-ignored.

# Claude API key (answer generation from phase 3 on)
ANTHROPIC_API_KEY=

# Local Postgres from docker compose (defaults shown)
# REVIEWPROOF_DATABASE_URL=postgresql://reviewproof:reviewproof@localhost:54329/reviewproof
# REVIEWPROOF_TEST_DATABASE_URL=postgresql://reviewproof:reviewproof@localhost:54329/reviewproof_test

# Embeddings (defaults shown). Device defaults to CUDA if available, else CPU.
# REVIEWPROOF_EMBEDDING_MODEL=BAAI/bge-m3
# REVIEWPROOF_EMBEDDING_DIM=1024
# REVIEWPROOF_EMBEDDING_BATCH_SIZE=32
# REVIEWPROOF_EMBEDDING_DEVICE=cpu

# Retrieval (defaults shown). The reranker uses the same device as embeddings.
# REVIEWPROOF_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# REVIEWPROOF_FULL_CONTEXT_MAX_TOKENS=6000

# QA workflow (defaults shown)
# REVIEWPROOF_LLM_MODEL=claude-haiku-5-5
# REVIEWPROOF_LLM_EFFORT=low
# REVIEWPROOF_MAX_REWRITES=1

# MCP server transport: stdio (default), sse or streamable-http
# REVIEWPROOF_MCP_TRANSPORT=stdio
